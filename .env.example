# MongoDB (free tier Atlas connection string)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/antitheft

# Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini — TWO accounts/keys for auto fallback when one hits quota
GEMINI_API_KEY_1=your_first_gemini_key
GEMINI_API_KEY_2=your_second_gemini_key

# Simple shared secret so random people can't hit your endpoint and burn your quota
DEVICE_AUTH_TOKEN=choose-a-long-random-string-here

PORT=3000
